{$SITE_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; connect-src 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }

    basic_auth {
        {$DEMO_USER} {$DEMO_PASSWORD_HASH}
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:3000 {
            header_up -Authorization
        }
    }

    handle {
        root * /srv/telemedicine-ehr/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
