ORACLE_USER=telemedicine_user
ORACLE_PASSWORD=replace_with_your_local_password
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
# For Oracle Autonomous Database mTLS, use a TCPS service descriptor from tnsnames.ora.
# ORACLE_WALLET_B64=base64_encoded_ewallet_pem
# ORACLE_WALLET_PASSWORD=wallet_download_password
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
# For a non-Vercel production server, set NODE_ENV=production and PUBLIC_ORIGIN=https://your-domain.example.
# For Vercel, set DEPLOY_TARGET=vercel plus generated DEMO_PASSWORD_SCRYPT,
# SESSION_SECRET, and CRON_SECRET. PUBLIC_ORIGIN defaults to VERCEL_PROJECT_PRODUCTION_URL.

# D.A. 3 timeline. Enable locally after starting Cassandra and creating its table.
CASSANDRA_ENABLED=false
CASSANDRA_KEYSPACE=care_continuum
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DC=datacenter1
# Astra cloud alternative; server-side only. Do not commit the token or bundle.
# CASSANDRA_TOKEN=application_token
# CASSANDRA_SECURE_BUNDLE_PATH=absolute_path_to_secure_connect_bundle.zip
# On Vercel, use CASSANDRA_SECURE_BUNDLE_B64 instead of the local file path.
