ORACLE_USER=telemedicine_user
ORACLE_PASSWORD=replace_with_your_local_password
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
# For Oracle Autonomous Database mTLS, use a TCPS service descriptor from tnsnames.ora.
# ORACLE_WALLET_B64=base64_encoded_ewallet_pem
# ORACLE_WALLET_PASSWORD=wallet_download_password
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
# Set NODE_ENV=production and PUBLIC_ORIGIN=https://your-domain.example on the server.
# For a single Azure App Service web app also set HOST=0.0.0.0 and SERVE_FRONTEND=true.
# For Vercel set DEPLOY_TARGET=vercel, PUBLIC_ORIGIN, and generated DEMO_PASSWORD_SCRYPT,
# SESSION_SECRET, and CRON_SECRET in Vercel's server-side environment settings.
# Set EXTERNAL_AUTH=true only when Caddy or Azure App Service already protects all routes.
